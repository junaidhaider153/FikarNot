# FikarNot backend
FIKARNOT_API_PORT=8787
FIKARNOT_FRONTEND_ORIGIN=http://localhost:5173,http://localhost:4173

# Optional: use a different API origin in deployed environments.
VITE_API_URL=

# Local development only: include a reset URL in the forgot-password response.
# Must be exactly "1" to take effect, and is always ignored when NODE_ENV=production.
FIKARNOT_EXPOSE_RESET_LINKS=1

# Production only. If the users table is empty on boot in production, a single
# admin account is created with a random password printed once to the server
# log (email defaults to admin@fikarnot.shop, override with FIKARNOT_ADMIN_EMAIL).
# Set FIKARNOT_SEED_DEMO_USERS=1 ONLY if you intentionally want the well-known
# junaid@/editor@/urwa@ demo accounts seeded in production (not recommended).
# FIKARNOT_ADMIN_EMAIL=admin@yourdomain.com
# FIKARNOT_SEED_DEMO_USERS=0

# Skip the Have I Been Pwned breach check on new passwords. Useful for offline/
# air-gapped environments, or to avoid flaky external calls during automated tests.
# The check already fails open (allows the password) if the API is unreachable,
# so this is only needed if you want to skip the outbound call entirely.
# FIKARNOT_DISABLE_BREACH_CHECK=1

# Demo data is seeded in development by default. Set to 0 when you want a clean database.
FIKARNOT_SEED_DEMO_DATA=1
FIKARNOT_ADMIN_EMAIL=admin@fikarnot.shop
FIKARNOT_APP_URL=http://localhost:5173
FIKARNOT_SUPPORT_EMAIL=support@fikarnot.shop

# Transactional email (optional until you configure a provider)
RESEND_API_KEY=
RESEND_FROM_EMAIL=FikarNot <onboarding@resend.dev>


# Email verification
# New customer registrations must verify their email before login.
# In development, the API returns a dev verification URL when email delivery is not configured.
FIKARNOT_EMAIL_VERIFICATION_TTL_HOURS=24

# Passwords must be at least 12 characters. Never use demo credentials in production.
VITE_SHOW_DEMO_LOGIN=0

# Trust X-Forwarded-For only when the app is behind a reverse proxy you control.
FIKARNOT_TRUST_PROXY=0
# Used by postbuild sitemap generation when the production catalogue API is reachable during build.
SITEMAP_API_URL=
# Optional public base URL for uploaded files when using a reverse proxy/object-storage gateway.
FIKARNOT_UPLOADS_PUBLIC_BASE_URL=
# Demo card processing is disabled in production; connect a real payment provider before enabling card checkout.
FIKARNOT_ENABLE_MOCK_PAYMENTS=0
VITE_ENABLE_MOCK_PAYMENTS=0

# Production hardening
# NODE_ENV=production
# SITE_URL=https://www.fikarnot.shop
# FIKARNOT_SEED_DEMO_DATA=0
# FIKARNOT_ENABLE_MOCK_PAYMENTS=0
# FIKARNOT_EXPOSE_RESET_LINKS=0
