# Frontend (Vite) — copy to .env.local for development; set the same names in Vercel.
# Public by design: these two values ship to every browser. NEVER put the
# service-role key, Gmail secrets or any password here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# Optional
VITE_WHATSAPP_NUMBER=

# Features that are NOT wired up on the Supabase backend yet. Leave unset/false.
VITE_ENABLE_PAYFAST=false
VITE_ENABLE_AI_CHAT=false
VITE_ENABLE_VIDEO_UPLOAD=false

# Build-time SEO output (sitemap + prerender). Used by `npm run build`;
# defaults to the catalog function of VITE_SUPABASE_URL.
SITE_URL=https://www.fikarnot.shop
# SITEMAP_API_URL=
