# Edge Function secrets. Set with:  supabase secrets set --env-file supabase/functions/.env
# (the real .env is git-ignored). SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are
# injected automatically by Supabase — do not set them.

# Comma-separated list of browser origins allowed to call the functions.
ALLOWED_ORIGINS=https://www.fikarnot.shop,https://fikarnot-live.vercel.app

# Used in email links.
APP_PUBLIC_URL=https://www.fikarnot.shop

# Staff 2FA: staff with an enrolled TOTP factor must always use a 2FA-verified
# token. Set to 1 ONLY after every staff account has enrolled TOTP — it then
# also blocks staff who have not enrolled.
STAFF_MFA_REQUIRED=0

# Transactional email via the Gmail API (HTTPS). Create the refresh token once
# with scripts/get-gmail-refresh-token.mjs (see docs/EMAIL_SETUP.md).
GMAIL_SENDER_EMAIL=fikarnotofficial.shop@gmail.com
GMAIL_SENDER_NAME=FikarNot
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# AI Shopping Assistant (Gemini REST API). Get an API key from Google AI Studio.
# Defaults to gemini-2.5-flash if GEMINI_MODEL is omitted.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
